APP_HOST=0.0.0.0
APP_PORT=8000

# SQLite file inside the api container's /data volume (four slashes: an
# absolute path).
DATABASE_URL=sqlite+aiosqlite:////data/climate_iot.db

# Comma-separated browser origins allowed to call the API cross-origin.
# Normally empty: the frontend proxies /api on its own origin, so browsers
# never call the API cross-origin. Empty disables CORS entirely.
CORS_ALLOWED_ORIGINS=

# Container-internal port the frontend's nginx listens on.
FRONTEND_PORT=4173
# Host port the frontend is published on -- on 127.0.0.1 only, so it's
# reachable from this machine and through `tailscale serve`, never from
# the LAN. Change this if 5173 is already in use.
FRONTEND_HOST_PORT=5173

# The api runs two listeners. APP_PORT (above) serves only the device API
# (/api/v1/device/*) and is the one published to the LAN, on
# API_HOST_PORT. Point the ESP32's BACKEND_BASE_URL (include/secrets.h) at
# http://<this machine's LAN IP>:<API_HOST_PORT>.
API_HOST_PORT=8000
# The full API (management, /docs) listens here inside the Docker network
# only; the frontend proxies to it. Must differ from APP_PORT.
INTERNAL_API_PORT=8001

# Shared secret for the device API: the ESP32 and the simulator send it as
# the X-Device-Key header, and the api answers 401 without it. If unset,
# every device request gets 503. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and put the same value in the ESP32's include/secrets.h (DEVICE_API_KEY).
DEVICE_API_KEY=

# The device-simulator service only starts with `docker compose --profile
# simulator up`. Uncomment to make it start with a plain `docker compose up`
# instead (Docker Compose reads this var itself, not the container):
# COMPOSE_PROFILES=simulator

# The simulator talks to the device listener (APP_PORT) over the Docker
# network, sending DEVICE_API_KEY like the ESP32 does.
API_BASE_URL=http://api:8000
DEVICE_HARDWARE_ID=sim-bedroom-001
DEVICE_NAME=Bedroom

HEARTBEAT_INTERVAL_SECONDS=10
TELEMETRY_INTERVAL_SECONDS=5
COMMAND_POLL_INTERVAL_SECONDS=3

AMBIENT_TEMPERATURE=26.0
STARTING_TEMPERATURE=24.0
TEMPERATURE_STEP=0.5
