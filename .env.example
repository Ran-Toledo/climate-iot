POSTGRES_USER=climate_app
POSTGRES_PASSWORD=climate_dev_password
POSTGRES_DB=climate_iot

APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+asyncpg://climate_app:climate_dev_password@db:5432/climate_iot

# Comma-separated browser origins allowed to call the API cross-origin.
# Normally empty: the frontend proxies /api on its own origin, so browsers
# never call the API cross-origin. Empty disables CORS entirely.
CORS_ALLOWED_ORIGINS=

# Container-internal port for the frontend's `vite preview` static server.
FRONTEND_PORT=4173
# Host port the frontend is published on -- on 127.0.0.1 only, so it's
# reachable from this machine and through `tailscale serve`, never from
# the LAN. Change this if 5173 is already in use.
FRONTEND_HOST_PORT=5173

# Host port the API is published on, on every interface, so the ESP32 can
# reach it over Wi-Fi (and other devices over the LAN or Tailscale). Point
# the ESP32's BACKEND_BASE_URL (include/secrets.h) at
# http://<this machine's LAN IP>:<this port>.
API_HOST_PORT=8000

# The device-simulator service only starts with `docker compose --profile
# simulator up`. Uncomment to make it start with a plain `docker compose up`
# instead (Docker Compose reads this var itself, not the container):
# COMPOSE_PROFILES=simulator

API_BASE_URL=http://api:8000
DEVICE_HARDWARE_ID=sim-bedroom-001
DEVICE_NAME=Bedroom

HEARTBEAT_INTERVAL_SECONDS=10
TELEMETRY_INTERVAL_SECONDS=5
COMMAND_POLL_INTERVAL_SECONDS=3

AMBIENT_TEMPERATURE=26.0
STARTING_TEMPERATURE=24.0
TEMPERATURE_STEP=0.5
