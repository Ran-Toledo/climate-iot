POSTGRES_USER=climate_app
POSTGRES_PASSWORD=climate_dev_password
POSTGRES_DB=climate_iot
# Host port for connecting external tools (psql, pgAdmin) to Postgres.
# Change this if 5432 is already taken by another local Postgres install.
POSTGRES_PORT=5432

APP_HOST=0.0.0.0
APP_PORT=8000
# Host port the API is reachable on from outside Docker.
# Change this if 8000 is already in use on your machine.
API_HOST_PORT=8000

DATABASE_URL=postgresql+asyncpg://climate_app:climate_dev_password@db:5432/climate_iot

# Comma-separated browser origins allowed to call the API (needed for the
# frontend's dev server, which runs on a different origin). Empty disables
# CORS entirely -- fine for the device simulator/ESP32, which aren't browsers.
# Testing from a phone or another device on your LAN? Add that origin too,
# e.g. http://localhost:5173,http://192.168.1.42:5173 (see VITE_API_BASE_URL
# below -- same LAN-IP-vs-localhost issue applies to both).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Container-internal port for the frontend's `vite preview` static server.
FRONTEND_PORT=4173
# Host port the frontend is reachable on from outside Docker.
# Change this if 5173 is already in use (e.g. by `npm run dev` locally).
FRONTEND_HOST_PORT=5173
# The URL the frontend calls the API at -- baked into the frontend's static
# bundle at image build time (see docker-compose.yml's frontend service),
# so changing this needs `docker compose up --build -d frontend`, not just
# a restart. Must be reachable from the BROWSER, not just this machine:
# `localhost` only works when browsing from the same machine running
# Docker. Testing from a phone/tablet on your LAN? Use this machine's LAN
# IP instead (ipconfig / ifconfig / ip addr -- whichever interface your
# phone's network actually reaches), e.g. http://192.168.1.42:8000, and add
# the matching origin to CORS_ALLOWED_ORIGINS above.
VITE_API_BASE_URL=http://localhost:8000

# The device-simulator service only starts with `docker compose --profile
# simulator up`. Uncomment to make it start with a plain `docker compose up`
# instead (Docker Compose reads this var itself, not the container):
# COMPOSE_PROFILES=simulator

API_BASE_URL=http://api:8000
DEVICE_HARDWARE_ID=sim-bedroom-001
DEVICE_NAME=Bedroom

HEARTBEAT_INTERVAL_SECONDS=10
TELEMETRY_INTERVAL_SECONDS=5
COMMAND_POLL_INTERVAL_SECONDS=3

AMBIENT_TEMPERATURE=26.0
STARTING_TEMPERATURE=24.0
TEMPERATURE_STEP=0.5
