APP_HOST=0.0.0.0

# SQLite file inside the api container's /data (bind-mounted from ./data;
# four slashes: an absolute path).
DATABASE_URL=sqlite+aiosqlite:////data/climate_iot.db

# Comma-separated browser origins allowed to call the API cross-origin.
# Normally empty: the frontend proxies /api on its own origin, so browsers
# never call the API cross-origin. Empty disables CORS entirely.
CORS_ALLOWED_ORIGINS=

# Ports. Inside the containers the web listens on WEB_PORT and the api runs
# two listeners: API_PORT (full API: management, /docs) and DEVICE_API_PORT
# (only /api/v1/device/*). API_PORT and DEVICE_API_PORT must differ.
WEB_PORT=3000
API_PORT=8000
DEVICE_API_PORT=8001

# Host ports. The web and the full API are published on 127.0.0.1 only, so
# they're reachable from this machine and through `tailscale serve`, never
# from the LAN.
WEB_HOST_PORT=3030
API_HOST_PORT=8030
# The device API is published on every interface, for the ESP32. Point its
# BACKEND_BASE_URL (include/secrets.h) at
# http://<this machine's LAN IP>:<DEVICE_API_HOST_PORT>.
DEVICE_API_HOST_PORT=8080

# Shared secret for the device API: the ESP32 and the simulator send it as
# the X-Device-Key header, and the api answers 401 without it. If unset,
# every device request gets 503. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and put the same value in the ESP32's include/secrets.h (DEVICE_API_KEY).
DEVICE_API_KEY=

# The device-simulator service only starts with `docker compose --profile
# simulator up`. Uncomment to make it start with a plain `docker compose up`
# instead (Docker Compose reads this var itself, not the container):
# COMPOSE_PROFILES=simulator

# The simulator talks to the device listener (DEVICE_API_PORT) over the Docker
# network, sending DEVICE_API_KEY like the ESP32 does.
API_BASE_URL=http://api:8001
DEVICE_HARDWARE_ID=sim-bedroom-001
DEVICE_NAME=Bedroom

HEARTBEAT_INTERVAL_SECONDS=10
TELEMETRY_INTERVAL_SECONDS=5
COMMAND_POLL_INTERVAL_SECONDS=3

AMBIENT_TEMPERATURE=26.0
STARTING_TEMPERATURE=24.0
TEMPERATURE_STEP=0.5
