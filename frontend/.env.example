# Must be reachable from your BROWSER, not just this machine: `localhost`
# only works when browsing from the same machine running `npm run dev` (or
# the backend). Testing from a phone/tablet on your LAN? Use this machine's
# LAN IP instead (ipconfig / ifconfig / ip addr), e.g. http://192.168.1.42:8000
# -- and add the matching http://<lan-ip>:5173 origin to the backend's
# CORS_ALLOWED_ORIGINS (../.env). `npm run dev` already binds all interfaces
# (see vite.config.ts), so the dev server itself is reachable either way.
VITE_API_BASE_URL=http://localhost:8000
